# Copy this file to .env and fill in your values
# Required — long random string for signing auth tokens
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL used for links inside emails (e.g. password reset / verify)
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Gmail SMTP (use an App Password: myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM=RideMate <your-email@gmail.com>
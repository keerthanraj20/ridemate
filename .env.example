# Copy this file to .env and fill in your values
# Required — long random string for signing auth tokens
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL used for links inside emails (e.g. password reset / verify)
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Gmail SMTP (use an App Password: myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM=RideMate <your-email@gmail.com>

# Phone OTP over SMS. Providers: "twilio" | "textlocal" | "console" (default).
# In "console" mode OTPs are printed to the server log so the flow works in dev.
SMS_PROVIDER=console
# Set SMS_LOG=1 to always mirror every SMS to the server log, even in prod.
#SMS_LOG=1

# Twilio (SMS_PROVIDER=twilio)
#SMS_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#SMS_TWILIO_AUTH_TOKEN=your-twilio-auth-token
#SMS_TWILIO_FROM=+15017122661

# Textlocal.in (SMS_PROVIDER=textlocal)
#SMS_TEXTLOCAL_API_KEY=your-textlocal-api-key
#SMS_TEXTLOCAL_SENDER=RDMATE

# ── Payments / Escrow ────────────────────────────────────────────────────────
# "mock" (default, no money moves) or "razorpay" (requires API keys below).
#PAY_PROVIDER=mock
#PAY_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
#PAY_RAZORPAY_KEY_SECRET=your-razorpay-key-secret
#PAY_RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Number of days after payment capture before auto-releasing to the owner (default 3).
#PAY_RELEASE_GRACE_DAYS=3

# ── Geocoding / Place search ─────────────────────────────────────────────────
# Provider for address search & reverse geocoding (Hyderabad dict is always
# checked first and needs no key). "nominatim" (default, free, no key),
# "google", or "mapmyindia". If a chosen provider's key is missing the app
# falls back to Nominatim automatically.
#GEOCODER=nominatim
# Google Maps API key (requires Places + Geocoding APIs enabled).
#GOOGLE_MAPS_API_KEY=AIza...
# MapMyIndia API key (India-native data, free tier available).
#MAPMYINDIA_API_KEY=your-mapmyindia-key

# ── Security limits ──────────────────────────────────────────────────────────
# Minimum password length (default 8).
#PASSWORD_MIN=8
# Max OTP attempts before lockout (default 5).
#OTP_MAX_ATTEMPTS=5

# Daily DB backup + CSV exports folder (unset = backups disabled).
#RM_BACKUP_DIR=server/backups